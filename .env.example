# Deployment-specific runtime only. Economic assumptions live in versioned typed configuration.
BESS_DATA_DIR=./data
BESS_SOURCE_MODE=pinned
BESS_AEMO_BASE_URL=https://nemweb.com.au/Reports/Archive/DispatchIS_Reports/
BESS_MAX_RANGE_DAYS=31
BESS_HTTP_CONNECT_TIMEOUT_S=5
BESS_HTTP_READ_TIMEOUT_S=60
BESS_HTTP_RETRIES=2
BESS_SOLVER_TIMEOUT_S=30
BESS_MAX_CONCURRENT_SOLVES=1
BESS_QUEUE_TIMEOUT_S=10
BESS_LOG_LEVEL=INFO
BESS_DEV_CORS_ORIGIN=http://127.0.0.1:5173
